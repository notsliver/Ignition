# Copy to .env and fill in. Never commit .env.

# Password for IGNITION's own PostgreSQL database. Use a long random value.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# 32 random bytes, base64. Encrypts environment variables and secrets at rest.
# Generate with:  openssl rand -base64 32
# Keep a backup: without this key, stored secrets can't be recovered. Changing it breaks existing secrets.
IGNITION_SECRET_KEY=

# The URL you open IGNITION at. Used to reject cross-site requests.
IGNITION_PUBLIC_URL=http://localhost:8080

# Port the dashboard listens on.
IGNITION_PORT=8080

# Set to true when IGNITION is served over HTTPS (e.g. behind a reverse proxy).
IGNITION_SECURE_COOKIES=false

# Hostname shown in links to deployed apps' published ports.
IGNITION_PUBLISH_HOST=localhost

# How many jobs (deployments, restarts) the worker runs at once.
IGNITION_WORKER_CONCURRENCY=2
